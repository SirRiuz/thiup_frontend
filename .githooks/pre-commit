#!/usr/bin/env bash
# Pre-commit hook: enforce the "comments must be in English" convention.
# Heuristic guard — see CONTRIBUTING.md. Enable once per clone with:
#     git config core.hooksPath .githooks
set -euo pipefail

# Only check staged JS/JSX/CSS files (i18n locale JSON is never included).
mapfile -t files < <(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '\.(js|jsx|css)$' || true)

if [ "${#files[@]}" -eq 0 ]; then
  exit 0
fi

node scripts/check-comment-language.js "${files[@]}"
